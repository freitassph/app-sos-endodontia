{
  "name": "sos-endodontia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:browser": "node scripts/qa-browser.mjs",
    "qa:responsive": "node scripts/qa-responsive-contract.mjs",
    "preview": "vite preview",
    "test:dependency-contracts": "node --test patches/dependency-contracts.check.cjs"
  },
  "dependencies": {
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "axe-core": "^4.13.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "braces": "file:patches/braces-3.0.3-depth128-parentguard-r3.tgz"
  },
  "overrides": {
    "vitest": {
      "vite": "$vite"
    },
    "braces": "$braces",
    "postcss-selector-parser@<6.1.5": "6.1.5"
  }
}
